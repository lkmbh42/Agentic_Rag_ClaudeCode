{
  "title": "Agentic RAG — Ops",
  "uid": "agentic-rag-ops",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["rag", "phase5"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {"list": [{
    "name": "datasource", "type": "datasource", "query": "prometheus",
    "current": {"text": "Prometheus", "value": "Prometheus"}
  }]},
  "panels": [
    {
      "id": 1, "title": "Chat latency (P50/P95/P99)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(rag_chat_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(rag_chat_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(rag_chat_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 2, "title": "Semantic cache hit rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"expr": "sum(rate(rag_semantic_cache_events_total{outcome=\"hit\"}[10m])) / clamp_min(sum(rate(rag_semantic_cache_events_total[10m])), 1)", "legendFormat": "hit rate"}
      ]
    },
    {
      "id": 3, "title": "Global in-flight (admission control)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "rag_global_inflight", "legendFormat": "in-flight"}]
    },
    {
      "id": 4, "title": "Queue depth", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "rag_queue_depth", "legendFormat": "ingest+eval"}]
    },
    {
      "id": 5, "title": "Indexing backlog", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "rag_indexing_backlog", "legendFormat": "docs"}]
    },
    {
      "id": 6, "title": "vLLM tokens/s", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "gen tok/s"}]
    },
    {
      "id": 7, "title": "GPU utilization (DCGM)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "id": 8, "title": "Backend up", "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 24},
      "targets": [{"expr": "up{job=\"backend\"}", "legendFormat": "backend"}]
    }
  ]
}
