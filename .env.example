# ============================================================================
# Agentic RAG Platform — environment template
# Copy to `.env` and adjust. `.env` is gitignored and never committed.
# Values marked [DEV] / [PROD] differ between environments; see docs/dev-vs-prod.md
# ============================================================================

# ---------------------------------------------------------------------------
# Core / app
# ---------------------------------------------------------------------------
APP_ENV=dev                       # dev | prod  — selects safe defaults in code
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
BACKEND_PORT=8000
# Comma-separated CORS origins (admin-ui, local tools). Tighten in prod.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL  (users, permissions, documents, chat history, checkpoints, audit)
# ---------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432                 # in-network port the app connects to (keep 5432)
# Host-published port (dev convenience for `psql` from the laptop). Separate from
# POSTGRES_PORT so you can dodge collisions with other local stacks, e.g. 5433.
POSTGRES_HOST_PORT=5432
# Async + sync URLs are derived in app/config.py from the values above.

# ---------------------------------------------------------------------------
# Redis  (queues, rate-limit counters, JWT jti denylist)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379                    # in-network port the app connects to (keep 6379)
REDIS_HOST_PORT=6379              # host-published port (override if 6379 is taken)
REDIS_DB=0

# ---------------------------------------------------------------------------
# Qdrant  (hybrid dense+sparse vector store)
# ---------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=rag_chunks

# ---------------------------------------------------------------------------
# MinIO object store (Phase 2: figure crops + page renders). Internal network
# only — objects are served exclusively through the ACL-checking gateway.
# MINIO_KMS_SECRET_KEY enables SSE-S3: "minio-default-key:<base64 32-byte key>".
# Generate for prod:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-only        # CHANGE IN PROD
MINIO_ACCESS_KEY=minioadmin                    # app credentials (root ok in dev)
MINIO_SECRET_KEY=minioadmin-dev-only
MINIO_KMS_SECRET_KEY=minio-default-key:bXktZGV2LW9ubHktMzItYnl0ZS1rbXMta2V5LTEyMzQ=   # CHANGE IN PROD
MINIO_BUCKET_FIGURES=figures
MINIO_BUCKET_PAGES=pages

# ---------------------------------------------------------------------------
# Phase 2 ingestion pipeline
# ---------------------------------------------------------------------------
PARSER_BACKEND=docling               # docling | legacy (rollback)
# Pre-staged Docling layout/TableFormer artifacts (Rule 2). Prod: /models/docling
# (stage with scripts/stage-docling-models.sh). Empty = library cache (dev only).
#DOCLING_ARTIFACTS_PATH=/models/docling

# ---------------------------------------------------------------------------
# Phoenix  (local observability / tracing — air-gapped)
# ---------------------------------------------------------------------------
PHOENIX_HOST=phoenix
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# ---------------------------------------------------------------------------
# LLM serving — the base_url is the ONLY thing that changes dev<->prod.
#   [DEV]  Ollama, CPU, OpenAI-compatible        -> http://ollama:11434/v1
#   [PROD] vLLM single instance, OpenAI-compat   -> http://vllm:8000/v1
# Rollback (Phase 1): set LLM_BACKEND/LLM_BASE_URL/LLM_GEN_MODEL back to the
# previous backend — no code change required.
# ---------------------------------------------------------------------------
LLM_BACKEND=ollama                  # ollama | vllm — names the backend for ops/health
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=not-needed-local        # OpenAI client requires a non-empty value
# Generation model id as the server advertises it (served-model-name).
LLM_GEN_MODEL=qwen2.5:3b            # [DEV] ollama tag; [PROD] e.g. qwen2.5-7b-awq
# Classification/grading reuses the same served model (single-vLLM topology).
LLM_CLASS_MODEL=qwen2.5:3b
LLM_REQUEST_TIMEOUT_S=120
# Phase 4: TRUE only when the served generation model accepts image content
# parts (a VL model) — gates query-time image context (assembler + generate).
# The ratified ADR keeps this FALSE on the 24 GB prod host (text 7B-AWQ; zero
# query-time VLM calls; visual questions answer from pre-computed captions).
LLM_MULTIMODAL=false

# vLLM-only knobs (ignored in dev). Cross-ref ADR 0.5 VRAM table (24 GB target).
VLLM_MODEL_PATH=/models/qwen2.5-7b-instruct-awq
VLLM_SERVED_MODEL_NAME=qwen2.5-7b-awq
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=48
VLLM_GPU_MEMORY_UTILIZATION=0.72
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_SCHEDULING_POLICY=priority      # short router/grader calls jump the queue
VLLM_GUIDED_DECODING_BACKEND=xgrammar
# --- CLAUDE.md Phase 4 VL configuration (requires >=48 GB VRAM — ADR upgrade
# path; do NOT apply on the 24 GB host, VL-32B-AWQ + KV does not fit):
#   VLLM_MODEL_PATH=/models/qwen2.5-vl-32b-instruct-awq   (pinned revision, PINS.md)
#   VLLM_SERVED_MODEL_NAME=qwen2.5-vl-32b-awq
#   LLM_GEN_MODEL=qwen2.5-vl-32b-awq
#   LLM_MULTIMODAL=true
#   (router/graders stay on a small text model — two-vLLM topology per ADR 0.5)

# ---------------------------------------------------------------------------
# Embeddings + reranker service (BGE-M3 dense+sparse, bge-reranker-v2-m3)
# ---------------------------------------------------------------------------
EMBEDDINGS_BASE_URL=http://embeddings:8001
EMBEDDINGS_PORT=8001
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# [DEV] cpu  | [PROD] cuda
EMBEDDINGS_DEVICE=cpu
# Backend selector: [DEV] hashing/lexical (in-process, fast, no model download)
#                   [PROD] service (BGE-M3 + cross-encoder container)
EMBEDDINGS_BACKEND=hashing
RERANKER_BACKEND=lexical
# Set EMBEDDINGS_IMPLEMENTED=true in the embeddings container to load BGE-M3.
EMBEDDINGS_IMPLEMENTED=false

# ---------------------------------------------------------------------------
# VLM service (Qwen2.5-VL-7B) — full path, CPU at ingest (ADR 0.3)
#   [DEV] degraded path: VLM service is OFF; ingest stores OCR + marker.
# ---------------------------------------------------------------------------
VLM_BASE_URL=http://vlm:8002
VLM_PORT=8002
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLM_DEVICE=cpu
# dev: degraded (no VLM container). prod: full (VLM on CPU at ingest).
VISUAL_PATH=degraded                 # degraded | full

# ---------------------------------------------------------------------------
# Auth / JWT (ADR 0.5: short-lived access + refresh rotation + Redis denylist)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Refresh token is an httpOnly cookie (needs the SPA same-origin behind /api).
# COOKIE_SECURE MUST be true in prod (HTTPS) so the cookie is never sent over
# plaintext; leave false for local dev over HTTP.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Dev seed admin (python -m app.seed). NEVER use these defaults in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-pass-123

# ---------------------------------------------------------------------------
# Retrieval / cache (wired in Phase 4 — defaults pinned here now)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=20                   # candidates before rerank
RETRIEVAL_TOP_N=5                    # chunks after rerank into the generator
SEMANTIC_CACHE_SIMILARITY=0.95
SEMANTIC_CACHE_TTL_S=86400
SEMANTIC_CACHE_PURGE_INTERVAL_S=3600 # worker sweep of expired entries (Phase 3)

# ---------------------------------------------------------------------------
# Phase 3 — visual retrieval / fusion / metadata / context assembly
# ---------------------------------------------------------------------------
VISUAL_TOP_K_PAGES=4                 # page images by MAX_SIM (spec: top 4)
FUSION_RRF_K=60                      # RRF damping constant (standard 60)
METADATA_MAX_DOCUMENTS=10            # docs listed by a metadata-intent lookup
CONTEXT_TOKEN_BUDGET=3000            # hard text budget into the generator
                                     # [PROD GPU] raise for the VL-32B context
CONTEXT_MAX_IMAGES=4                 # spec: <=4 page images per answer

# ---------------------------------------------------------------------------
# Circuit breakers / quotas (wired in Phase 5/concurrency — pinned now)
# ---------------------------------------------------------------------------
MAX_GRAPH_ITERATIONS=25
# Corrective-loop retries. [PROD GPU] 2/1. [DEV CPU] set both 0 — each retry is
# another slow LLM call and the weak 3B grader triggers them spuriously.
MAX_RETRIEVAL_RETRIES=2
MAX_GENERATION_RETRIES=1
# Async LLM-as-judge eval. [DEV] false — on a single-CPU model it competes with
# chat for the LLM and makes responses crawl. [PROD GPU] true.
EVAL_ENABLED=true
# Hallucination/grounding grader. [DEV] false — the 3B grader gives false
# negatives and discards correct answers. [PROD GPU] true.
HALLUCINATION_CHECK_ENABLED=true
MAX_INDEXING_RETRIES=3
MAX_REQUEST_DURATION_S=90
PER_USER_MAX_INFLIGHT=3
PER_USER_TOKENS_PER_MIN=20000

# ---------------------------------------------------------------------------
# Admin UI (Phase 9 SPA served by nginx)
# ---------------------------------------------------------------------------
ADMIN_UI_PORT=8080
