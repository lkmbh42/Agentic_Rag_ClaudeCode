# Force LF on everything that runs inside Linux containers.
# CRLF from a Windows checkout silently breaks container entrypoints and shell scripts.
* text=auto eol=lf

*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
entrypoint*     text eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.gguf  binary
*.safetensors binary
